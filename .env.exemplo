# Banco do GLPI de teste (fica na VPS, não aqui no seu computador).
# Gere valores próprios, por exemplo com: openssl rand -hex 24
GLPI_DB_ROOT_PASSWORD=
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=

# GLPI de produção — SOMENTE LEITURA, usado para copiar os cadastros.
GLPI_PROD_URL=https://helpdesk.broadcastti.com.br
GLPI_PROD_APP_TOKEN=
GLPI_PROD_USER_TOKEN=

# GLPI de teste. O acesso é por túnel SSH direto no container, para não
# esbarrar na senha do site: ./scripts/abrir-tunel.sh
GLPI_TESTE_URL=http://127.0.0.1:3300
GLPI_TESTE_APP_TOKEN=
GLPI_TESTE_USER_TOKEN=
